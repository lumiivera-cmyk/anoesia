# Copy this file to `.env` and fill in your key: `cp .env.example .env`
# Bun loads `.env` automatically when the server starts.

# Your nanoGPT API key (https://nano-gpt.com, under API settings).
NANOGPT_API_KEY=

# Google Vertex AI, for profiles set to it (Gemini models only). Optional.
# Signs in with a service account key file. If Amaedori already uses it,
# copy gcp-key.json from there and use the same three lines.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# "global", or a region such as us-central1.
GOOGLE_CLOUD_LOCATION=global

# Everything below is optional; the values shown are the defaults.

# Where the server listens. 127.0.0.1 means only this device can connect.
# There's no login yet, so don't open it to the network.
# HOST=127.0.0.1
# PORT=4950  (Amaedori uses 4949, so both can run at once)

# Other names you open the app by, besides localhost and IP addresses
# (comma-separated), like a Tailscale machine name.
# ALLOWED_HOSTS=

# REQUEST_TIMEOUT_SECONDS=180
# DATA_DIR=./data
